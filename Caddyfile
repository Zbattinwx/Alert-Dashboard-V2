# =============================================================================
# Caddy Reverse Proxy - Alert Dashboards
#
# Routes:
#   /v1/*  -> V1 dashboard (Windows PC on LAN, HTTP :8000 + WS :8765)
#   /v2/*  -> V2 dashboard (Docker container on port 3074)
#   /      -> Redirect to /v2/
#
# External: atmosphericx.ddns.net (HTTPS, Let's Encrypt)
# LAN:      http://<pi-ip>/v2/ (plain HTTP, no cert needed)
# Requires ports 80 + 443 forwarded to the Pi.
#
# Windows PC LAN IP: 192.168.1.88 (DHCP reserved)
# =============================================================================

# --- External access (HTTPS with auto-SSL) ---
atmosphericx.ddns.net {
    # /v1 without trailing slash -> redirect to /v1/
    redir /v1 /v1/ permanent

    # V1 - WebSocket (must come before the general /v1/* handler)
    handle /v1/ws {
        reverse_proxy 192.168.1.88:8765
    }

    # V1 - Alert Dashboard V1 (strip /v1 prefix before forwarding)
    handle_path /v1/* {
        reverse_proxy 192.168.1.88:8000
    }

    # V1 - API routes (absolute paths used by V1 frontend JS)
    # These don't have a /v1 prefix in the code, so we match them at the root
    handle /api/* {
        reverse_proxy 192.168.1.88:8000
    }

    # /v2 without trailing slash -> redirect to /v2/
    redir /v2 /v2/ permanent

    # V2 - Alert Dashboard V2 (strip /v2 prefix before forwarding)
    handle_path /v2/* {
        reverse_proxy v2:3074
    }

    # Root -> redirect to V2
    redir / /v2/ permanent

    # Catch-all for anything else
    respond "Alert Dashboards: <a href='/v1/'>V1</a> | <a href='/v2/'>V2</a>" 200 {
        close
    }
}

# --- LAN access (plain HTTP, no SSL) ---
http:// {
    redir /v1 /v1/ permanent

    handle /v1/ws {
        reverse_proxy 192.168.1.88:8765
    }

    handle_path /v1/* {
        reverse_proxy 192.168.1.88:8000
    }

    handle /api/* {
        reverse_proxy 192.168.1.88:8000
    }

    redir /v2 /v2/ permanent

    handle_path /v2/* {
        reverse_proxy v2:3074
    }

    redir / /v2/ permanent

    respond "Alert Dashboards: <a href='/v1/'>V1</a> | <a href='/v2/'>V2</a>" 200 {
        close
    }
}
