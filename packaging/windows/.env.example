# Alert Dashboard V2 - Server .env  (rename to ".env" next to start-server.bat)
#
# Easiest path: just copy your working .env from the dev project over this file.
# This template documents the settings that matter for the Windows server build.

# --- Server ---
# start-server.bat sets HOST=127.0.0.1 so only Caddy is exposed. Set HOST=0.0.0.0
# here only if you also want to hit the backend directly at http://<this-pc>:3074.
HOST=127.0.0.1
PORT=3074
DEBUG=false
BRAND=onw

# --- Geographic + phenomena filtering (JSON arrays) ---
FILTER_STATES=["OH", "KS", "OK", "MO"]
TARGET_PHENOMENA=["TO","TOR","TOA","SV","SVR","SVS","SVA","FF","FFW","FFS","FFA","FLW","FLS","FLA","WS","WSW","WSA","BZ","IS","LE","WW","WC","CW","HW","WI","SQ"]

# --- NWWS-OI weather wire (leave blank for API-only mode) ---
NWWS_USERNAME=
NWWS_PASSWORD=

# --- LLM / AI agent (optional; needs Ollama installed on this PC) ---
LLM_ENABLED=false
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
AGENT_ENABLED=false
AGENT_MODEL=qwen2.5-coder:7b

# --- Radar (optional, heavy) ---
NEXRAD_ENABLED=true
NEXRAD_DEFAULT_SITE=KILN
NEXRAD_CHUNKS_ENABLED=true

# --- Social media (optional) ---
FB_ENABLED=false
FB_PAGE_ID=
FB_ACCESS_TOKEN=
BSKY_ENABLED=false
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# --- Spotter Network (optional) ---
SPOTTER_NETWORK_ENABLED=false

# --- Google Chat (optional) ---
GOOGLE_CHAT_ENABLED=false
GOOGLE_CHAT_WEBHOOK_URL=

# Note: CADDY_ENABLED is NOT used by the server bundle. start-server.bat always
# launches caddy.exe when caddy.exe + Caddyfile are present next to it.
DOMAIN=atmosphericx.ddns.net
