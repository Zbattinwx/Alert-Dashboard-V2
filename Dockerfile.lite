# =============================================================================
# Alert Dashboard V2 - LITE image (no NEXRAD radar stack)
# Target: linux/arm64 (Raspberry Pi 4). Build on a beefy PC with buildx,
#         then `docker save` + `docker load` on the Pi (see build-pi-image.ps1).
#
# Differences from the full Dockerfile:
#   - requirements.lite.txt (no arm-pyart/scipy/boto3/matplotlib/netCDF4)
#   - no libhdf5/libnetcdf runtime libs (those are only for netCDF4/pyart)
#   - smaller image, far faster build (numpy/shapely/Pillow install as wheels)
# =============================================================================

# Stage 1: Build frontend with Vite (unchanged - radar UI is inert without data)
FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit
COPY frontend/ ./
ENV VITE_BASE_PATH=/v2/
RUN npm run build

# Stage 2: Build Python dependencies
# Rust is kept because slixmpp/cryptography may compile from source on arm64.
# This stage runs on the build host (your PC), not the Pi, so compile cost is cheap.
FROM python:3.12-slim AS python-build
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libgeos-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    libffi-dev \
    pkg-config \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (required by slixmpp/cryptography on ARM if no prebuilt wheel)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

RUN pip install --upgrade pip

COPY requirements.lite.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.lite.txt

# Stage 3: Slim runtime image (no compilers, no Rust, no HDF5/NetCDF)
FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgeos-c1v5 \
    libjpeg62-turbo \
    zlib1g \
    libffi8 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=python-build /install /usr/local

# Copy backend code
COPY backend/ ./backend/

# Copy built frontend from stage 1
COPY --from=frontend-build /app/frontend/dist ./frontend/dist

# Copy widgets (vanilla JS ticker overlays for OBS/streaming)
COPY widgets/ ./widgets/

# Data directory for alerts.json, user_settings.json, broadcast graphics
RUN mkdir -p /app/data

ENV HOST=0.0.0.0
ENV PORT=3074
ENV DEBUG=false

EXPOSE 3074

CMD ["python", "backend/main.py"]
